# Published image to run with Docker Compose.
# Once this project is in GitHub, releases are published automatically as:
# ghcr.io/<github-owner>/<repository>:latest
MAPBAN_IMAGE=ghcr.io/YOUR-GITHUB-OWNER/YOUR-REPOSITORY:latest

# Optional: Discord channel webhook. Leave empty to hide the publish button.
DISCORD_WEBHOOK_URL=

# Spectra organization code. Required to create new mapban sessions.
SPECTRA_ORGANIZATION_CODE=
